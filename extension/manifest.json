{
  "manifest_version": 3,
  "name": "SyncWatch",
  "version": "1.0.0",
  "description": "Assista Netflix, Prime Video, Disney+, Max, YouTube e outros sincronizado com seus amigos.",
  "minimum_chrome_version": "116",
  "permissions": ["scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SyncWatch",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
